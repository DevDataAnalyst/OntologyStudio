  "dataProviders": [
    {
      "id": "DP0",
      "name": "Ledger",
      "dataSourceId": "UNV_CNR_FIN",
      "dataSourceType": "unx",
      "querySpecification": {
        "resultObjects": [
          "O_FY",
          "O_FP",
          "M_OPEX",
          "M_REV_GL",
          "M_OR"
        ],
        "filters": {
          "operator": "And",
          "conditions": [
            {
              "predefinedFilter": "F_CLOSED"
            }
          ]
        }
      },
      "customSql": false,
      "promptValues": {},
      "queryPlan": {
        "statements": [
          "SELECT\n  FISCAL_PERIODS.FISCAL_YEAR,\n  FISCAL_PERIODS.PERIOD_NUMBER,\n  SUM(GL_JOURNAL_LINES.EXPENSE_AMOUNT),\n  SUM(GL_JOURNAL_LINES.REVENUE_AMOUNT),\n  SUM(GL_JOURNAL_LINES.EXPENSE_AMOUNT)/NULLIF(SUM(GL_JOURNAL_LINES.REVENUE_AMOUNT),0)\nFROM\n  CNR_FIN.FISCAL_PERIODS  FISCAL_PERIODS,\n  CNR_FIN.GL_JOURNAL_LINES  GL_JOURNAL_LINES\nWHERE\n  ( GL_JOURNAL_LINES.PERIOD_ID=FISCAL_PERIODS.PERIOD_ID  )\n  AND  ( FISCAL_PERIODS.IS_CLOSED = 1 )\nGROUP BY\n  FISCAL_PERIODS.FISCAL_YEAR,\n  FISCAL_PERIODS.PERIOD_NUMBER"
        ]
      }
    },
    {
      "id": "DP1",
      "name": "Billing",
      "dataSourceId": "UNV_CNR_FIN",
      "dataSourceType": "unx",
      "querySpecification": {
        "resultObjects": [
          "O_FY",
          "O_FP",
          "M_FREV"
        ],
        "filters": {
          "operator": "And",
          "conditions": [
            {
              "predefinedFilter": "F_CLOSED"
            }
          ]
        }
      },
      "customSql": false,
      "promptValues": {},
      "queryPlan": {
        "statements": [
          "SELECT\n  FISCAL_PERIODS.FISCAL_YEAR,\n  FISCAL_PERIODS.PERIOD_NUMBER,\n  SUM(FREIGHT_BILLING.LINE_REVENUE)\nFROM\n  CNR_FIN.FISCAL_PERIODS  FISCAL_PERIODS,\n  CNR_FIN.FREIGHT_BILLING  FREIGHT_BILLING\nWHERE\n  ( FREIGHT_BILLING.PERIOD_ID=FISCAL_PERIODS.PERIOD_ID  )\n  AND  ( FISCAL_PERIODS.IS_CLOSED = 1 )\nGROUP BY\n  FISCAL_PERIODS.FISCAL_YEAR,\n  FISCAL_PERIODS.PERIOD_NUMBER"
        ]
      }
    }
  ],
  "variables": [
