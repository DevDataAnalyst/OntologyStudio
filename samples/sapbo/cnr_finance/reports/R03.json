      "queryPlan": {
        "statements": [
          "SELECT\n  FISCAL_CALENDAR.FISCAL_YEAR,\n  EXTRACT(MONTH FROM FISCAL_CALENDAR.PERIOD_START),\n  FISCAL_CALENDAR.PERIOD_START,\n  NVL(FREIGHT_REVENUE.ORIGIN_REGION,'Unknown'),\n  SUM(FREIGHT_REVENUE.TOTAL_REVENUE)\nFROM\n  CNR_FIN.FISCAL_CALENDAR  FISCAL_CALENDAR,\n  CNR_FIN.FREIGHT_REVENUE  FREIGHT_REVENUE\nWHERE\n  ( FREIGHT_REVENUE.PERIOD_START=FISCAL_CALENDAR.PERIOD_START  )\nGROUP BY\n  FISCAL_CALENDAR.FISCAL_YEAR,\n  EXTRACT(MONTH FROM FISCAL_CALENDAR.PERIOD_START),\n  FISCAL_CALENDAR.PERIOD_START,\n  NVL(FREIGHT_REVENUE.ORIGIN_REGION,'Unknown')"
        ]
      }
    }
  ],
  "variables": [
    {
      "id": "V_PY",
      "name": "Revenue PY",
      "qualification": "Measure",
      "formula": "=RelativeValue([Freight Revenue];([Fiscal Year]);-1)"
    },
    {
      "id": "V_YTD",
      "name": "Revenue YTD",
      "qualification": "Measure",
      "formula": "=RunningSum([Freight Revenue];([Fiscal Year]))"
    },
    {
      "id": "V_YOY",
      "name": "YoY %",
      "qualification": "Measure",
      "formula": "=([Freight Revenue]-[Revenue PY])/[Revenue PY]"
    }
