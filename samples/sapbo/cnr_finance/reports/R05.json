      "promptValues": {},
      "queryPlan": {
        "statements": [
          "SELECT\n  NVL(AR_INVOICES.AGING_BUCKET,'Paid'),\n  CUSTOMERS.CUSTOMER_NAME,\n  SUM(AR_INVOICES.OPEN_AMOUNT),\n  SUM(CASE WHEN AR_INVOICES.DUE_DATE < DATE '2025-12-31' THEN AR_INVOICES.OPEN_AMOUNT END),\n  SUM(AR_INVOICES.INVOICE_AMOUNT),\n  AVG(AR_INVOICES.INVOICE_AMOUNT)\nFROM\n  CNR_FIN.AR_INVOICES  AR_INVOICES,\n  CNR_FIN.CUSTOMERS  CUSTOMERS\nWHERE\n  ( AR_INVOICES.CUSTOMER_ID=CUSTOMERS.CUSTOMER_ID  )\n  AND  ( AR_INVOICES.OPEN_AMOUNT > 0 )\nGROUP BY\n  NVL(AR_INVOICES.AGING_BUCKET,'Paid'),\n  CUSTOMERS.CUSTOMER_NAME"
        ]
      }
    }
  ],
  "variables": [
    {
      "id": "V_OVDPCT",
      "name": "Overdue %",
      "qualification": "Measure",
      "formula": "=[AR Overdue Amount]/[AR Open Amount]"
