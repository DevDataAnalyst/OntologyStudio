        "statements": [
          "SELECT\n  FISCAL_PERIODS.FISCAL_YEAR,\n  CUSTOMERS.CUSTOMER_NAME,\n  CUSTOMERS.INDUSTRY,\n  SUM(FREIGHT_BILLING.LINE_REVENUE),\n  SUM(FREIGHT_BILLING.CARLOADS)\nFROM\n  CNR_FIN.CUSTOMERS  CUSTOMERS,\n  CNR_FIN.FISCAL_PERIODS  FISCAL_PERIODS,\n  CNR_FIN.FREIGHT_BILLING  FREIGHT_BILLING\nWHERE\n  ( FREIGHT_BILLING.CUSTOMER_ID=CUSTOMERS.CUSTOMER_ID  )\n  AND  ( FREIGHT_BILLING.PERIOD_ID=FISCAL_PERIODS.PERIOD_ID  )\n  AND  ( FISCAL_PERIODS.FISCAL_YEAR = 2025 )\nGROUP BY\n  FISCAL_PERIODS.FISCAL_YEAR,\n  CUSTOMERS.CUSTOMER_NAME,\n  CUSTOMERS.INDUSTRY"
        ]
      }
