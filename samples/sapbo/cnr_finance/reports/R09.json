          ]
        }
      },
      "customSql": false,
      "promptValues": {},
      "queryPlan": {
        "statements": [
          "SELECT\n  CUSTOMERS.CUSTOMER_NAME,\n  DECODE(CUSTOMERS.IS_KEY_ACCOUNT,1,'Yes','No'),\n  SUM(AR_INVOICES.OPEN_AMOUNT)\nFROM\n  CNR_FIN.AR_INVOICES  AR_INVOICES,\n  CNR_FIN.CUSTOMERS  CUSTOMERS\nWHERE\n  ( AR_INVOICES.CUSTOMER_ID=CUSTOMERS.CUSTOMER_ID  )\n  AND  ( CUSTOMERS.IS_KEY_ACCOUNT = 1 )\nGROUP BY\n  CUSTOMERS.CUSTOMER_NAME,\n  DECODE(CUSTOMERS.IS_KEY_ACCOUNT,1,'Yes','No')"
        ]
      }
    },
    {
      "id": "DP1",
      "name": "Customers",
      "dataSourceId": "UNV_CNR_FIN",
      "dataSourceType": "unx",
      "querySpecification": {
        "resultObjects": [
          "O_CUST",
          "O_KEYACC",
          "M_HC"
        ],
        "filters": {
          "operator": "And",
          "conditions": [
            {
              "predefinedFilter": "F_KEYACC"
            }
          ]
        }
      },
      "customSql": false,
      "promptValues": {},
      "queryPlan": {
        "statements": [
          "SELECT\n  CUSTOMERS.CUSTOMER_NAME,\n  DECODE(CUSTOMERS.IS_KEY_ACCOUNT,1,'Yes','No'),\n  SUM(CUSTOMERS.CREDIT_LIMIT)\nFROM\n  CNR_FIN.CUSTOMERS  CUSTOMERS\nWHERE\n  ( CUSTOMERS.IS_KEY_ACCOUNT = 1 )\nGROUP BY\n  CUSTOMERS.CUSTOMER_NAME,\n  DECODE(CUSTOMERS.IS_KEY_ACCOUNT,1,'Yes','No')"
        ]
      }
    }
  ],
