        "shortcut": false
      },
      {
        "id": "J13",
        "expression": "GL_ENTRIES.ACCOUNT_NUMBER=GL_ACCOUNTS.ACCOUNT_NUMBER",
        "cardinality": "N-1",
        "outer": false,
        "shortcut": false
      },
      {
        "id": "J14",
        "expression": "GL_ENTRIES.COST_CENTER_ID=COST_CENTERS.COST_CENTER_ID",
