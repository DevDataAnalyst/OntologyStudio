      {
        "id": "J01",
        "expression": "FREIGHT_REVENUE.CUSTOMER_ID=CUSTOMERS.CUSTOMER_ID",
        "cardinality": "N-1",
        "outer": false,
        "shortcut": false
      },
      {
        "id": "J02",
