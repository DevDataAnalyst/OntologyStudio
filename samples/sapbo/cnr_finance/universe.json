        "outer": false,
        "shortcut": false
      },
      {
        "id": "J15",
        "expression": "GL_ENTRIES.PERIOD_START=FISCAL_CALENDAR.PERIOD_START",
        "cardinality": "N-1",
        "outer": false,
        "shortcut": false
      },
      {
        "id": "J16",
        "expression": "BUDGET.ACCOUNT_NUMBER=BUDGET_ACCOUNT.ACCOUNT_NUMBER",
        "cardinality": "N-1",
        "outer": false,
        "shortcut": false
      },
      {
        "id": "J17",
        "expression": "BUDGET.COST_CENTER_ID=COST_CENTERS.COST_CENTER_ID",
        "cardinality": "N-1",
        "outer": false,
        "shortcut": false
      },
      {
        "id": "J18",
        "expression": "BUDGET.PERIOD_START=FISCAL_CALENDAR.PERIOD_START",
        "cardinality": "N-1",
        "outer": false,
        "shortcut": false
      },
      {
        "id": "J19",
        "expression": "AGG_MONTHLY_PERFORMANCE.PERIOD_START=FISCAL_CALENDAR.PERIOD_START",
        "cardinality": "N-1",
        "outer": false,
        "shortcut": false
      },
      {
        "id": "J20",
        "expression": "DT_PERIOD_CALENDAR.PERIOD_START=FISCAL_CALENDAR.PERIOD_START",
        "cardinality": "1-1",
        "outer": false,
        "shortcut": false
      },
      {
        "id": "J21",
        "expression": "AR_INVOICES.OPEN_AMOUNT BETWEEN BALANCE_BANDS.MIN_AMOUNT AND BALANCE_BANDS.MAX_AMOUNT",
        "cardinality": "N-1",
        "outer": false,
        "shortcut": false
      }
