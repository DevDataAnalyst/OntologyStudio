        "id": "T_DT_PERIOD_CALENDAR",
        "name": "DT_PERIOD_CALENDAR",
        "type": "derived",
        "sql": "SELECT PERIOD_START, FISCAL_YEAR*100 + EXTRACT(MONTH FROM PERIOD_START) AS YEAR_PERIOD FROM CNR_FIN.FISCAL_CALENDAR",
        "columns": [
